# Git LFS boilerplate that `git lfs install` wrote into our hooks folder. This
# repo tracks nothing with LFS, and `npm install` points core.hooksPath here,
# so committing these would block `git push` on any machine without git-lfs.
.githooks/post-checkout
.githooks/post-commit
.githooks/post-merge
.githooks/pre-push

