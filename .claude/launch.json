{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5175
    },
    {
      "name": "pixel-harness",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5199",
        "--bind",
        "127.0.0.1",
        "--directory",
        "tools/pixel-harness"
      ],
      "port": 5199
    },
    {
      "name": "built-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve@14",
        "-s",
        "dist",
        "-l",
        "4174",
        "--no-clipboard"
      ],
      "port": 4174
    }
  ]
}
